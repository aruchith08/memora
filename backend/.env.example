# ==========================================
# MEMORA Backend Environment Configuration
# ==========================================

# Server configuration
HOST=0.0.0.0
PORT=8000

# Qdrant Vector Database Configuration
# Option 1: Standalone Qdrant service (Docker / Cloud / Local instance)
# Uncomment the line below to connect to a running Qdrant instance:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_api_key_here

# Option 2: Local embedded on-disk storage (zero setup, fallback default)
# Leave QDRANT_URL empty to automatically use embedded storage.
QDRANT_PATH=./qdrant_storage

# Qdrant Collection Settings
QDRANT_COLLECTION_NAME=voice_memory

# Lyzr Agent Studio Configuration
LYZR_API_KEY=
LYZR_AGENT_ID=
LYZR_USER_ID=
LYZR_API_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/

# Omi Notification Configuration
OMI_APP_ID=
OMI_APP_SECRET=
