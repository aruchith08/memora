# ==========================================
# MEMORA Backend Environment Configuration
# ==========================================

# Server configuration
# Local default port is 8000; in Zoho Catalyst AppSail, X_ZOHO_CATALYST_LISTEN_PORT is automatically provided
HOST=0.0.0.0
PORT=8000
# X_ZOHO_CATALYST_LISTEN_PORT=80

# Qdrant Vector Database Configuration
# Option 1: Standalone Qdrant service (Docker / Cloud / Local instance)
# Uncomment the line below to connect to a running Qdrant instance:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_api_key_here

# Option 2: Local embedded on-disk storage (zero setup, fallback default)
# Leave QDRANT_URL empty to automatically use embedded storage.
QDRANT_PATH=./qdrant_storage

# Qdrant Collection Settings
QDRANT_COLLECTION_NAME=voice_memory

# Lyzr Agent Studio Configuration
LYZR_API_KEY=
LYZR_AGENT_ID=
LYZR_MANAGER_AGENT_ID=
LYZR_ACTION_PLANNER_AGENT_ID=
LYZR_USER_ID=
LYZR_API_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/

# Omi Notification Configuration
OMI_APP_ID=
OMI_APP_SECRET=

# Frontend Dashboard & CORS Configuration
# Comma-separated list of additional allowed origins for the frontend
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://memora-arh.vercel.app
# Deployment & Security Configuration
# Set to 'production' for strict startup validation (enforces remote Qdrant, disallows embedded fallback)
ENVIRONMENT=development

# Server-scoped demo user identity for UI memory browsing and search
DEMO_UID=memora_demo_user

# Optional secret for Omi Webhook callbacks (checked via ?secret= or X-Omi-Webhook-Secret header)
# Leave empty for frictionless local testing; set in production to prevent arbitrary trigger calls
OMI_WEBHOOK_SECRET=

# Secret key required for administrative and manual mutation endpoints in production
MEMORA_ADMIN_KEY=

